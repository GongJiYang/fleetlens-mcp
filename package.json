{
  "name": "@luminondev/mcp-dashboard",
  "version": "0.9.24",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "bin": {
    "luminon": "bin/luminon.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "packages/cli/dist/**/*",
    "packages/core/dist/**/*",
    "packages/mcp-server/dist/**/*",
    "packages/renderer/dist/**/*",
    "packages/shared/dist/**/*",
    "packages/shared/templates.json",
    "data/**/*",
    "CHANGELOG.md",
    "docs/MCP_DOCUMENTATION.md",
    "README.md",
    "LICENSE",
    "bin/luminon.js"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "scripts": {
    "build": "npm run build -w @mcp-dashboard/shared && npm run build -w @mcp-dashboard/core && npm run build -w @mcp-dashboard/mcp-server && npm run build -w @mcp-dashboard/renderer && npm run build -w @mcp-dashboard/cli",
    "test": "npm run build && node --import tsx --test packages/shared/test/index.test.ts packages/core/test/index.test.ts packages/mcp-server/test/storage-nl.test.ts",
    "test:unit": "node --import tsx --test packages/shared/test/index.test.ts packages/core/test/index.test.ts packages/mcp-server/test/storage-nl.test.ts",
    "test:integration:renderer": "npm run build -w @mcp-dashboard/renderer && node --import tsx --test packages/renderer/test/share-links.test.ts",
    "dev:mcp": "npm run dev -w @mcp-dashboard/mcp-server",
    "dev:mcp:http": "npm run dev:http -w @mcp-dashboard/mcp-server",
    "dev:renderer": "npm run dev -w @mcp-dashboard/renderer",
    "dev:stack": "concurrently \"npm run dev:mcp\" \"npm run dev:renderer\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "type": "module"
}
